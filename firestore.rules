rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == '1gcD31Rz0waqXKo7YoMYbr3VTQ03';
    }

    function isPoolMember(poolId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.members;
    }

    function competitionMatch(competitionId, matchId) {
      return get(/databases/$(database)/documents/competitions/$(competitionId)/matches/$(matchId)).data;
    }

    function matchIsOpen(competitionId, matchId) {
      return exists(/databases/$(database)/documents/competitions/$(competitionId)/matches/$(matchId))
        && request.time < competitionMatch(competitionId, matchId).kickoffAt;
    }

    function podiumPredictionIsOpen(competitionId) {
      return exists(/databases/$(database)/documents/competitions/$(competitionId))
        && get(/databases/$(database)/documents/competitions/$(competitionId)).data.podiumPredictionEnabled == true
        && request.time < get(/databases/$(database)/documents/competitions/$(competitionId)).data.podiumPredictionDeadline;
    }

    function validPodiumPrediction(uid) {
      return request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.champion is string
        && request.resource.data.runnerUp is string
        && request.resource.data.thirdPlace is string
        && request.resource.data.champion != request.resource.data.runnerUp
        && request.resource.data.champion != request.resource.data.thirdPlace
        && request.resource.data.runnerUp != request.resource.data.thirdPlace;
    }

    // Users: self read/write, admin can read/delete all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Pools
    match /pools/{poolId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members || isAdmin());
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.createdBy || isAdmin());

      // Bets
      match /bets/{betId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == request.resource.data.userId;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.userId
              || request.auth.uid == get(/databases/$(database)/documents/pools/$(poolId)).data.createdBy
              || isAdmin());
      }

      // Leaderboard
      match /leaderboard/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/pools/$(poolId)).data.createdBy
              || isAdmin());
      }

      // Test / auxiliary competitions inside a pool
      match /competitions/{competitionId} {
        allow read: if isPoolMember(poolId) || isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();

        match /bets/{betId} {
          allow read: if isPoolMember(poolId) || isAdmin();
          allow create: if isPoolMember(poolId)
            && request.auth.uid == request.resource.data.userId
            && request.resource.data.matchId is string
            && request.resource.data.predictedScoreA is int
            && request.resource.data.predictedScoreA >= 0
            && request.resource.data.predictedScoreB is int
            && request.resource.data.predictedScoreB >= 0
            && request.resource.data.keys().hasOnly([
              'userId', 'matchId', 'predictedScoreA', 'predictedScoreB',
              'createdAt', 'updatedAt'
            ])
            && matchIsOpen(competitionId, request.resource.data.matchId);
          allow update: if isPoolMember(poolId)
            && request.auth.uid == resource.data.userId
            && request.auth.uid == request.resource.data.userId
            && request.resource.data.matchId == resource.data.matchId
            && request.resource.data.predictedScoreA is int
            && request.resource.data.predictedScoreA >= 0
            && request.resource.data.predictedScoreB is int
            && request.resource.data.predictedScoreB >= 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'predictedScoreA', 'predictedScoreB', 'updatedAt'
            ])
            && matchIsOpen(competitionId, request.resource.data.matchId);
          allow delete: if request.auth != null
            && (request.auth.uid == resource.data.userId
                || request.auth.uid == get(/databases/$(database)/documents/pools/$(poolId)).data.createdBy
                || isAdmin());
        }

        match /leaderboard/{uid} {
          allow read: if isPoolMember(poolId) || isAdmin();
          allow create: if isPoolMember(poolId)
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
              'nickname', 'matchPoints', 'bonusPoints', 'totalPoints',
              'exactResultsCount', 'correctOutcomeCount'
            ])
            && request.resource.data.matchPoints == 0
            && request.resource.data.bonusPoints == 0
            && request.resource.data.totalPoints == 0;
          allow update: if isPoolMember(poolId)
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']);
          allow delete: if isAdmin();
        }

        match /matches/{matchId} {
          allow read: if isPoolMember(poolId) || isAdmin();
          allow write: if false;
        }

        match /podiumPredictions/{uid} {
          allow read: if isPoolMember(poolId) || isAdmin();
          allow create: if isPoolMember(poolId)
            && podiumPredictionIsOpen(competitionId)
            && validPodiumPrediction(uid)
            && request.resource.data.keys().hasOnly([
              'userId', 'champion', 'runnerUp', 'thirdPlace', 'submittedAt'
            ]);
          allow update: if isPoolMember(poolId)
            && resource.data.userId == request.auth.uid
            && podiumPredictionIsOpen(competitionId)
            && validPodiumPrediction(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'champion', 'runnerUp', 'thirdPlace', 'submittedAt'
            ]);
          allow delete: if isAdmin();
        }
      }
    }

    // Competition configuration and globally shared imported matches
    match /competitions/{competitionId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'podiumPredictionEnabled',
            'podiumPredictionDeadline'
          ])
          || resource.data.podiumPredictionDeadline == null
          || request.time < resource.data.podiumPredictionDeadline
        );

      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Admin logs: only admin can read/write
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null;
    }

    // Match results: admin writes, all read
    match /matchResults/{matchId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Analytics
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null;
    }

    // Legacy groups (read-only for migration)
    match /groups/{groupCode} {
      allow read: if request.auth != null;
      match /{sub}/{docId} {
        allow read: if request.auth != null;
      }
    }
  }
}
